# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.claude
# ml/ — the offline training pipeline (run once locally, never deployed).
# ml/data/ holds the raw review export: real startup names next to personal
# invest/pass verdicts. It must never be committed — and neither may anything
# derived from it row by row. Only the aggregate outputs leave this folder:
# lib/invest/model.onnx and lib/invest/model-card.json.
/ml/data/
/ml/.venv/
/ml/.pytest_cache/
/ml/.ruff_cache/
__pycache__/
